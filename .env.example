# Discord application and development server
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# OpenAI: set models available to your API project.
# The Supabase schema uses the 1536 dimensions produced by text-embedding-3-small.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

MONGODB_URI=mongodb://localhost:27017/hackerhelp

# Server-side credentials only. Never expose the service role key in a client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: existing Supabase schemas may require an auth.users UUID for documents.created_by.
SUPABASE_DOCUMENT_OWNER_ID=

# Comma-separated Discord user IDs
SUPER_ADMIN_IDS=
PORT=3000
