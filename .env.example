# Discord application and development server
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Anthropic: answer decisions and drafting (announcements, judge summaries).
ANTHROPIC_API_KEY=
# Optional; defaults to claude-haiku-4-5 (cheapest). The recorded evals ran on claude-opus-5-5.
# ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI: embeddings only. The Supabase schema uses the 1536 dimensions of text-embedding-3-small.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

MONGODB_URI=mongodb://localhost:27017/hackerhelp

# Support job queue (BullMQ). Leave empty to process jobs inline, without queued retries.
# Docker Compose sets this to its own Redis service.
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4

# Server-side credentials only. Never expose the service role key in a client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Support tickets: forum channel and moderator role, by ID or name (defaults shown).
# TICKET_FORUM_CHANNEL=hacker-help-desk
# TICKET_MODERATOR_ROLE=Moderator
# Duplicate detection thresholds (from npm run eval:dedup; see eval/RESULTS.md)
# TICKET_DUPLICATE_SIMILARITY=0.8
# TICKET_RELATED_SIMILARITY=0.65

# Retrieval tuning (defaults chosen from `npm run eval:rag`; see eval/RESULTS.md)
# RAG_RETRIEVAL_FLOOR=0.25
# RAG_ANSWER_MIN_SIMILARITY=0.3
# RAG_TOP_K=6

# Comma-separated Discord user IDs
SUPER_ADMIN_IDS=

# Bearer token for the operator-only HTTP API (/api/*). Leave empty to disable the API.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

PORT=3000
